{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
  "type": "builtin",
  "source": "fedora",
  "width": 12,
  "padding": {
    "top": 1,
    "left": 2
  }
},

  "display": {
    "separator": "  ",
    "brightColor": false,

    "key": {
      "width": 14
    }
  },

  "modules": [
    {
      "type": "title",
      "format": "╭─────────────"
    },

    {
      "type": "custom",
      "format": "│   Fedora • GNOME • Ghostty"
    },

    "break",

    {
      "type": "os",
      "key": "│ 󰣇 "
    },

    {
      "type": "host",
      "key": "│ 󰌢 "
    },

    {
      "type": "uptime",
      "key": "│ 󰅐 "
    },

    {
      "type": "shell",
      "key": "│  "
    },

    {
      "type": "de",
      "key": "│ 󰧨 "
    },

    {
      "type": "wm",
      "key": "│ 󰖲 "
    },

    {
      "type": "terminal",
      "key": "│  "
    },

    {
      "type": "cpu",
      "key": "│ 󰻠 "
    },

    {
      "type": "memory",
      "key": "│ 󰑭 "
    },

    {
      "type": "disk",
      "key": "│ 󰋊 "
    },

    "break",

    {
      "type": "colors",
      "paddingLeft": 4,
      "symbol": " "
    },

    {
      "type": "custom",
      "format": "╰───────────── Fedora 44"
    }
  ]
}